# Example environment configuration for Sentence Gymnasium.
# - DATABASE_URL is the MySQL connection string. It is read at runtime by
#   PrismaClient (server/utils/prisma.ts) and by the Prisma CLI (migrate/db execute).
# - All secrets (AI_API_KEY, AUTH_SECRET, ...) are read from process.env at
#   runtime. Locally copy this file to `.env` with real values; in production
#   set them as environment variables (e.g. EdgeOne Makers console).

# ===== SEO / GEO: Canonical site URL
# ⚠️ 必需设置为实际部署的完整域名（含协议，无尾斜杠）。
# sitemap.xml / canonical URL / OG image URL 均基于此变量构建。
NUXT_PUBLIC_SITE_URL=https://sentencegym.waterspo.top

# MySQL — provided by your cloud MySQL instance
DATABASE_URL="mysql://user:password@host:3306/database"

# AI provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NUXT_SECRET=

# Turnstile
# Public site key (used by Nuxt client module)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (used by server-side verifyTurnstileToken)
NUXT_TURNSTILE_SECRET_KEY=

# Waffo Pancake (recharge/payments)
# ⚠️ 以下变量仅用于一次性写入数据库（`npx tsx scripts/seed-waffo-config.ts`）。
# 应用运行时从数据库 app_config 表读取 Waffo 配置，不走环境变量
# （规避 EdgeOne 环境变量值 500 字节限制，私钥无需分段）。
WAFFO_MERCHANT_ID=
# RSA private key (PEM, or base64-encoded PEM for CI). See waffo-pancake docs.
WAFFO_PRIVATE_KEY=
# Waffo onetime product IDs per credit pack (created by `scripts/waffo-setup.ts`，
# 该脚本会自动写入数据库)
WAFFO_PRODUCT_PACK_100=
WAFFO_PRODUCT_PACK_500=
WAFFO_PRODUCT_PACK_1500=

# ===== SEO 效果监测指标（可选，后续接 GA4 / Search Console 时使用）
# NUXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# NUXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxx  (google-site-verification)
# NUXT_PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxx (msvalidate.01)
# NUXT_PUBLIC_BAIDU_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxx (baidu-site-verification)
