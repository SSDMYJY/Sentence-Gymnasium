// Prisma schema for Sentence Gymnasium (MySQL).
// Note: JSON-shaped fields (options / extraData / feedback) are stored as String
// and parsed at the code layer with JSON.parse / JSON.stringify — MySQL keeps
// the same String-column semantics, so no type changes were needed.

generator client {
  provider      = "prisma-client-js"
  // Cloudflare Pages / Workers build images use RHEL-based runtimes with
  // either OpenSSL 1.1.x or 3.0.x. Generate engines for all of them so the
  // deployed bundle always finds a compatible Query Engine at runtime.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  // Read at runtime by PrismaClient (server/utils/prisma.ts) and by the Prisma CLI.
  // Example: mysql://user:password@host:3306/database
  url = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String?
  credits         Int      @default(20)
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  streak          Int      @default(0)
  level           Int      @default(1)
  experience      Int      @default(0)
  lastPracticeAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dailyGoal       Int      @default(5)
  attempts        Attempt[]
  generatedQuestions GeneratedQuestion[]
  bookmarks       Bookmark[]
  orders          Order[]

  @@map("users")
}

model GeneratedQuestion {
  id            String   @id @default(cuid())
  category      String // 'practice' | 'paraphrase' | 'grammar'
  languagePair  String? // 'ja-en' etc.; for paraphrase stores source lang e.g. 'ja'
  grammarTag    String? // 'te-form', 'present-perfect', ...
  questionText  String   @db.Text // displayed prompt text
  correctAnswer String   @db.Text // canonical answer
  options       String?  @db.Text // JSON string for choice questions
  extraData     String?  @db.Text // JSON string (e.g. paraphrase original text, grammar notes)
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())
  generatedById String?
  generatedBy   User?    @relation(fields: [generatedById], references: [id])
  attempts      Attempt[]

  @@index([category, languagePair, grammarTag])
  @@map("questions")
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  userAnswer String   @db.Text
  isCorrect  Boolean
  feedback   String?  @db.Text // JSON string with AI explanation/suggestion
  createdAt  DateTime @default(now())
  nextReviewAt DateTime?
  reviewLevel  Int      @default(0)
  user       User     @relation(fields: [userId], references: [id])
  question   GeneratedQuestion @relation(fields: [questionId], references: [id])

  @@index([userId, createdAt])
  @@index([nextReviewAt, reviewLevel])
  @@map("attempts")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  word        String
  sentence    String?  @db.Text
  sourceLang  String?
  category    String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, word])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

// Waffo Pancake 充值订单。status: pending → completed | failed | refunded
model Order {
  id                String   @id @default(cuid())
  userId            String
  packId            String // internal pack id (e.g. 'pack_100')
  productId         String // Waffo PROD_xxx
  credits           Int // credits granted on completion
  amount            String // display amount e.g. "2.99"
  currency          String   @default("USD")
  status            String   @default("pending")
  checkoutSessionId String? // Waffo cs_xxx session id
  waffoOrderId      String? // Waffo ORD_xxx (set by webhook)
  waffoEventId      String? // Waffo delivery event id (idempotency dedup)
  buyerEmail        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@index([waffoEventId])
  @@index([waffoOrderId])
  @@map("orders")
}

// 应用级键值配置（存数据库，不走环境变量）。
// 目前用于 Waffo 支付配置：
//   waffo.merchantId / waffo.privateKey
//   waffo.product.pack_100 / waffo.product.pack_500 / waffo.product.pack_1500
model AppConfig {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_config")
}